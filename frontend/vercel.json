{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://importadora-posn.onrender.com/api/:path*"
    },
    {
      "source": "/graphql",
      "destination": "https://importadora-posn.onrender.com/graphql"
    },
    {
      "source": "/hubs/:path*",
      "destination": "https://importadora-posn.onrender.com/hubs/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}